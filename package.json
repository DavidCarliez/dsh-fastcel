{
  "name": "dsh-fastcel",
  "version": "0.1.0",
  "description": "DeepSeek Harness plugin that starts each Vercel AI Gateway conversation on the fastest provider for its model",
  "type": "module",
  "license": "MIT",
  "author": "David Carliez",
  "homepage": "https://github.com/DavidCarliez/dsh-fastcel#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DavidCarliez/dsh-fastcel.git"
  },
  "bugs": "https://github.com/DavidCarliez/dsh-fastcel/issues",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek",
    "deepseek-harness",
    "deepseek-harness-plugin",
    "vercel",
    "ai-gateway",
    "llm",
    "routing",
    "throughput"
  ],
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.1-rc.2 <0.3.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepack": "npm run build",
    "test": "node --test test/*.test.mjs",
    "check:package": "node scripts/check-package.mjs"
  },
  "files": [
    "lib",
    "bundle.yml",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": "./lib/server.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./bundle.yml": "./bundle.yml"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./bundle.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-model-selection",
        "@deepseek-ai/dsh-client-ui-commands"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "react": "^18.3.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.2",
    "@deepseek-ai/dsh-llm-pi-ai": "0.2.1-rc.2",
    "esbuild": "^0.25.12",
    "react": "^18.3.1",
    "react-test-renderer": "18.3.1"
  },
  "overrides": {
    "@earendil-works/pi-ai": "1.3.0"
  }
}
